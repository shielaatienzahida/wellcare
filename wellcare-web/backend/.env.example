# === Local Development (SQLite) ===
JWT_SECRET=change_this_to_a_random_secret
DEVICE_KEY=heiwa_device
PORT=5000
# Set these values in backend/.env before using OTP password recovery.
# ADMIN_RECOVERY_EMAIL is saved to the default admin account on first setup,
# or fills it when that account's recovery email is blank.
ADMIN_RECOVERY_EMAIL=admin@example.com
# SMTP credentials are supplied by your email provider (use an app password where required).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=WellCare <no-reply@example.com>
